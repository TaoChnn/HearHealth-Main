<view class="chat-page">
  <view class="mode-banner" wx:if="{{modeHint}}">{{modeHint}}</view>

  <scroll-view
    class="chat-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollTarget}}"
  >
    <view class="chat-content">
      <!-- 空状态：保留 BT·01 作为助手的核心形象 -->
      <view class="welcome" wx:if="{{!messages.length}}">
        <view class="welcome-bot bt01-avatar" aria-hidden="true"></view>
        <view class="welcome-title">今天想聊聊什么？</view>
        <view class="welcome-text">
          <view>我会结合你的听力记录与用耳习惯，</view>
          <view>给出清晰、可靠的健康建议。</view>
        </view>
        <view class="suggestion-block">
          <view class="suggestion-label">你可以问问</view>
          <view class="suggestion-list">
            <view
              class="suggestion-chip"
              wx:for="{{suggestions}}"
              wx:key="*this"
              data-question="{{item}}"
              bindtap="sendSuggestion"
            >{{item}}</view>
          </view>
        </view>
      </view>

      <view
        id="message-{{item.id}}"
        class="message-row message-row--{{item.role}}"
        wx:for="{{messages}}"
        wx:key="id"
        wx:for-index="index"
      >
        <view class="message-ai-mark bt01-avatar" wx:if="{{item.role === 'assistant'}}" aria-hidden="true"></view>

        <view class="message-stack">
          <view class="message-bubble message-bubble--{{item.role}}" wx:if="{{item.content}}">
            <text>{{item.content}}</text>
            <text class="typing-cursor" wx:if="{{item.id === typingMessageId}}"></text>
          </view>

          <!-- 溯源标签：点任意标签都能跳到档案，回答里用到的档案数据在这里可查证 -->
          <view class="source-row" wx:if="{{item.sources.length}}">
            <text class="source-label">依据</text>
            <view
              class="source-chip"
              wx:for="{{item.sources}}"
              wx:for-item="source"
              wx:key="*this"
              bindtap="onOpenArchive"
            >{{source}}</view>
          </view>

          <!-- Agent 提议的写入动作：确认前不落库 -->
          <view class="action-card action-card--{{item.pendingAction.state}}" wx:if="{{item.pendingAction}}">
            <view class="action-head">
              <text class="action-title">{{item.pendingAction.title}}</text>
              <text class="action-state">{{actionStateText[item.pendingAction.state]}}</text>
            </view>
            <view class="action-summary">{{item.pendingAction.summary}}</view>
            <view class="action-buttons" wx:if="{{item.pendingAction.state === 'pending'}}">
              <button class="action-btn action-btn--ghost" data-index="{{index}}" bindtap="onCancelAction">取消</button>
              <button class="action-btn action-btn--primary" data-index="{{index}}" bindtap="onConfirmAction">确认</button>
            </view>
          </view>

          <!-- 已落库的写入：保留撤销入口，避免用户被 AI 改了数据却无法回退 -->
          <view class="action-card action-card--applied" wx:if="{{item.appliedAction}}">
            <view class="action-head">
              <text class="action-title">{{item.appliedAction.title}}</text>
              <text class="action-state">{{appliedStateText[item.appliedAction.state]}}</text>
            </view>
            <view class="action-summary">{{item.appliedAction.summary}}</view>
            <view class="action-buttons" wx:if="{{item.appliedAction.state === 'applied'}}">
              <button class="action-btn action-btn--ghost" data-index="{{index}}" bindtap="onUndoAction">撤销</button>
            </view>
          </view>
        </view>
      </view>

      <view class="message-row message-row--assistant" id="chat-loading" wx:if="{{loading}}">
        <view class="message-ai-mark bt01-avatar" aria-hidden="true"></view>
        <view class="message-bubble message-bubble--assistant loading-bubble">
          <text>AI 正在思考</text>
          <view class="loading-dots" aria-hidden="true">
            <view></view><view></view><view></view>
          </view>
        </view>
      </view>

      <view class="chat-error" id="chat-error" wx:if="{{errorMessage}}">
        <view class="chat-error-text">{{errorMessage}}</view>
        <button class="retry-button" bindtap="retryLastMessage">重新发送</button>
      </view>
      <view class="chat-bottom" id="chat-bottom"></view>
    </view>
  </scroll-view>

  <view class="chat-footer">
    <!-- 固定在输入框上方的快捷操作，方便在任何会话状态下使用 -->
    <view class="quick-actions">
      <view class="quick-card" hover-class="quick-card--pressed" hover-stay-time="80" bindtap="onOpenArchive">
        <view class="quick-card-archive-icon" aria-hidden="true">
          <view></view>
          <view></view>
        </view>
        <text class="quick-card-title">健康档案</text>
      </view>
      <view class="quick-card" hover-class="quick-card--pressed" hover-stay-time="80" bindtap="onNewChat">
        <image class="quick-card-icon" src="/images/chat-new.svg" mode="aspectFit"></image>
        <text class="quick-card-title">新对话</text>
      </view>
      <view class="quick-card" hover-class="quick-card--pressed" hover-stay-time="80" bindtap="onOpenHistory">
        <image class="quick-card-icon" src="/images/chat-history.svg" mode="aspectFit"></image>
        <text class="quick-card-title">历史</text>
      </view>
    </view>
    <view class="composer">
      <textarea
        class="composer-input"
        value="{{inputValue}}"
        placeholder="问问你的听力或用耳习惯"
        placeholder-class="composer-placeholder"
        maxlength="500"
        auto-height
        fixed
        cursor-spacing="16"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onConfirm"
      ></textarea>
      <view
        class="send-button {{loading || !inputValue ? 'send-button--disabled' : ''}}"
        hover-class="send-button--pressed"
        hover-stay-time="80"
        bindtap="sendCurrentInput"
      >↑</view>
    </view>
    <view class="chat-disclaimer">AI 生成内容仅供健康参考，不构成医学诊断</view>
  </view>

  <!-- 历史对话抽屉：点击恢复会话，删除需二次确认 -->
  <view class="history-mask" wx:if="{{historyVisible}}" bindtap="onCloseHistory"></view>
  <view class="history-panel" wx:if="{{historyVisible}}">
    <view class="history-head">
      <text class="history-title">历史对话</text>
      <view class="history-close" hover-class="history-close--pressed" hover-stay-time="80" bindtap="onCloseHistory">关闭</view>
    </view>
    <scroll-view class="history-list" scroll-y>
      <view class="history-empty" wx:if="{{!historySessions.length}}">还没有历史对话</view>
      <view
        class="history-item"
        wx:for="{{historySessions}}"
        wx:key="id"
        hover-class="history-item--pressed"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="onLoadSession"
      >
        <view class="history-item-main">
          <view class="history-item-title">{{item.title}}</view>
          <view class="history-item-meta">{{item.timeText}} · {{item.count}} 条消息</view>
        </view>
        <view class="history-item-del" data-id="{{item.id}}" catchtap="onDeleteSession">删除</view>
      </view>
    </scroll-view>
  </view>
</view>
