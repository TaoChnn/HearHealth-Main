page {
  height: 100%;
  overflow: hidden;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--color-canvas-parchment);
  color: var(--color-ink);
}

.message-ai-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--color-primary);
  background: #eef6ff;
  font-weight: 700;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 28rpx 28rpx 40rpx;
}

/* 运行模式提示：游客（没有云端档案）与离线（未配置大模型）都如实告知 */
.mode-banner {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  color: #8a6d1f;
  background: #fff8e6;
  border-bottom: 2rpx solid #f2e4bd;
  font-size: 24rpx;
  line-height: 1.4;
}

.welcome-card {
  padding: 34rpx;
  background: var(--color-canvas);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.3;
}

.welcome-text {
  margin-top: 14rpx;
  color: var(--color-ink-muted-48);
  font-size: 28rpx;
  line-height: 1.55;
}

.archive-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  background: #f8fbff;
  border: 2rpx solid #dceafb;
  border-radius: var(--radius-md);
}

.archive-entry--pressed {
  background: #eef6ff;
}

.archive-entry-text {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.archive-entry-arrow {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.suggestion-chip {
  box-sizing: border-box;
  padding: 16rpx 22rpx;
  color: var(--color-primary);
  background: #f4f8fd;
  border: 2rpx solid #dceafb;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 1.35;
}

.message-row {
  display: flex;
  align-items: flex-end;
  margin-top: 28rpx;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

.message-ai-mark {
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

/* 助手侧的气泡、溯源标签与动作卡片共用一个纵向容器，宽度由容器统一收敛 */
.message-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 78%;
}

.message-row--user .message-stack {
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

.message-bubble--user {
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-bottom-right-radius: 8rpx;
}

.message-bubble--assistant {
  color: var(--color-ink);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-divider-soft);
  border-bottom-left-radius: 8rpx;
  line-height: 1.65;
}

/* 溯源标签：回答用到了哪些档案数据，点击可跳到档案核对 */
.source-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.source-label {
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.source-chip {
  padding: 6rpx 16rpx;
  color: var(--color-primary);
  background: #f4f8fd;
  border: 2rpx solid #dceafb;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
}

/* Agent 提议/完成的档案写入：确认前不落库，落库后保留撤销入口 */
.action-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-md);
}

.action-card--pending {
  border-color: #dceafb;
  background: #f8fbff;
}

.action-card--confirming,
.action-card--applied {
  border-color: #d7ecd9;
  background: #f6fcf7;
}

.action-card--cancelled,
.action-card--dismissed,
.action-card--undo-failed {
  border-color: var(--color-divider-soft);
  background: var(--color-surface-pearl);
}

.action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.action-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.action-state {
  flex-shrink: 0;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.action-summary {
  margin-top: 10rpx;
  color: var(--color-ink-muted-80);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 60rpx;
}

.action-btn::after {
  border: none;
}

.action-btn--primary {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.action-btn--ghost {
  color: var(--color-ink-muted-48);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
}

/* 逐字渲染时挂在回复末尾的光标 */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  margin-left: 4rpx;
  vertical-align: -5rpx;
  background: var(--color-primary);
  animation: cursor-blink 0.9s steps(1) infinite;
}

@keyframes cursor-blink {
  50% { opacity: 0; }
}

.loading-bubble {
  display: flex;
  align-items: center;
  color: var(--color-ink-muted-48);
}

.loading-dots {
  display: flex;
  gap: 6rpx;
  margin-left: 12rpx;
}

.loading-dots view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-ink-muted-48);
  animation: chat-dot 1.2s infinite ease-in-out;
}

.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes chat-dot {
  0%, 60%, 100% { opacity: 0.28; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-4rpx); }
}

.chat-error {
  margin: 24rpx 0 0 66rpx;
  padding: 20rpx 22rpx;
  background: #fff5f4;
  border-radius: var(--radius-md);
}

.chat-error-text {
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.45;
}

.retry-button {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  color: var(--color-primary);
  background: var(--color-canvas);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 56rpx;
}

.retry-button::after,
.send-button::after {
  border: none;
}

.chat-bottom {
  height: 2rpx;
}

.chat-footer {
  flex-shrink: 0;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(250, 250, 252, 0.96);
  border-top: 2rpx solid var(--color-divider-soft);
}

.chat-disclaimer {
  margin-bottom: 10rpx;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
  line-height: 1.35;
  text-align: center;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-height: 76rpx;
  max-height: 190rpx;
  padding: 17rpx 22rpx;
  color: var(--color-ink);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #a1a1a6;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.send-button--disabled {
  color: #ffffff;
  background: #b8cbe0;
}
