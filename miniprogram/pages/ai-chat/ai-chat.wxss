page {
  height: 100%;
  overflow: hidden;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--color-canvas-parchment);
  color: var(--color-ink);
}

/* 消息旁的 BT·01 迷你头像：与首页/欢迎页同一形象 */
.message-ai-mark {
  flex-shrink: 0;
  width: 58rpx;
  height: 57rpx;
  margin-right: 14rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 28rpx 28rpx 40rpx;
}

/* 运行模式提示：游客（没有云端档案）与离线（未配置大模型）都如实告知 */
.mode-banner {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  color: #8a6d1f;
  background: #fff8e6;
  border-bottom: 2rpx solid #f2e4bd;
  font-size: 24rpx;
  line-height: 1.4;
}

/* ===== 空状态欢迎页：BT·01 居中出场，直接铺在羊皮纸底上 ===== */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 88rpx;
}

/* 与原设计一致的悬浮呼吸：待机时缓慢上下浮动 */
.welcome-bot {
  width: 150rpx;
  height: 147rpx;
  animation: welcome-bot-bob 3.4s ease-in-out infinite;
}

@keyframes welcome-bot-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.welcome-title {
  margin-top: 36rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.3;
}

.welcome-text {
  margin-top: 16rpx;
  color: var(--color-ink-muted-48);
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

.archive-entry {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 40rpx;
  padding: 16rpx 30rpx;
  background: var(--color-canvas);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-pill);
}

.archive-entry--pressed {
  background: var(--color-surface-pearl);
}

.archive-entry-text {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.archive-entry-arrow {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  opacity: 0.55;
}

.suggestion-block {
  width: 100%;
  margin-top: 64rpx;
}

.suggestion-label {
  color: var(--color-ink-muted-48);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.suggestion-chip {
  box-sizing: border-box;
  padding: 15rpx 26rpx;
  color: var(--color-ink-muted-80);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 1.35;
}

.message-row {
  display: flex;
  align-items: flex-end;
  margin-top: 28rpx;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

/* 助手侧的气泡、溯源标签与动作卡片共用一个纵向容器，宽度由容器统一收敛 */
.message-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 78%;
}

.message-row--user .message-stack {
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

.message-bubble--user {
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-bottom-right-radius: 8rpx;
}

.message-bubble--assistant {
  color: var(--color-ink);
  background: var(--color-canvas);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 41, 92, 0.05);
  line-height: 1.65;
}

/* 溯源标签：回答用到了哪些档案数据，点击可跳到档案核对 */
.source-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.source-label {
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.source-chip {
  padding: 6rpx 16rpx;
  color: var(--color-primary);
  background: #f4f8fd;
  border: 2rpx solid #dceafb;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
}

/* Agent 提议/完成的档案写入：确认前不落库，落库后保留撤销入口 */
.action-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-md);
}

.action-card--pending {
  border-color: #dceafb;
  background: #f8fbff;
}

.action-card--confirming,
.action-card--applied {
  border-color: #d7ecd9;
  background: #f6fcf7;
}

.action-card--cancelled,
.action-card--dismissed,
.action-card--undo-failed {
  border-color: var(--color-divider-soft);
  background: var(--color-surface-pearl);
}

.action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.action-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.action-state {
  flex-shrink: 0;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.action-summary {
  margin-top: 10rpx;
  color: var(--color-ink-muted-80);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 60rpx;
}

.action-btn::after {
  border: none;
}

.action-btn--primary {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.action-btn--ghost {
  color: var(--color-ink-muted-48);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
}

/* 逐字渲染时挂在回复末尾的光标 */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  margin-left: 4rpx;
  vertical-align: -5rpx;
  background: var(--color-primary);
  animation: cursor-blink 0.9s steps(1) infinite;
}

@keyframes cursor-blink {
  50% { opacity: 0; }
}

.loading-bubble {
  display: flex;
  align-items: center;
  color: var(--color-ink-muted-48);
}

.loading-dots {
  display: flex;
  gap: 6rpx;
  margin-left: 12rpx;
}

.loading-dots view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-ink-muted-48);
  animation: chat-dot 1.2s infinite ease-in-out;
}

.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes chat-dot {
  0%, 60%, 100% { opacity: 0.28; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-4rpx); }
}

.chat-error {
  margin: 24rpx 0 0 66rpx;
  padding: 20rpx 22rpx;
  background: #fff5f4;
  border-radius: var(--radius-md);
}

.chat-error-text {
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.45;
}

.retry-button {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  color: var(--color-primary);
  background: var(--color-canvas);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 56rpx;
}

.retry-button::after,
.send-button::after {
  border: none;
}

.chat-bottom {
  height: 2rpx;
}

.chat-footer {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(250, 250, 252, 0.96);
  border-top: 2rpx solid var(--color-divider-soft);
}

/* 免责声明收成一行脚注，放在输入框下方，不再挤压版面 */
.chat-disclaimer {
  margin-top: 12rpx;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

/* ===== 会话工具条与历史抽屉 ===== */
.chat-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  flex-shrink: 0;
  padding: 16rpx 24rpx 0;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  color: var(--color-ink-muted-80);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
}

.toolbar-icon {
  width: 26rpx;
  height: 26rpx;
}

.toolbar-btn--pressed {
  background: var(--color-surface-pearl);
}

.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(20, 20, 40, 0.4);
}

.history-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  background: var(--color-canvas);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: history-rise 0.25s ease-out;
}

@keyframes history-rise {
  from { transform: translateY(30%); opacity: 0.5; }
  to { transform: translateY(0); opacity: 1; }
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 18rpx;
}

.history-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 650;
}

.history-close {
  padding: 6rpx 10rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.history-close--pressed {
  opacity: 0.6;
}

.history-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.history-empty {
  padding: 60rpx 0;
  color: var(--color-ink-muted-48);
  font-size: 26rpx;
  text-align: center;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  padding: 24rpx 22rpx;
  background: var(--color-canvas-parchment);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-md);
}

.history-item--pressed {
  background: var(--color-surface-pearl);
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-item-title {
  color: var(--color-ink);
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item-meta {
  margin-top: 6rpx;
  color: var(--color-ink-muted-48);
  font-size: 21rpx;
}

.history-item-del {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  color: #b42318;
  background: #fff5f4;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-height: 88rpx;
  max-height: 190rpx;
  padding: 21rpx 26rpx;
  color: var(--color-ink);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  line-height: 1.45;
}

/* 用 view 而非原生 button，避免小程序默认按钮样式把圆钮撑成椭圆 */
.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-end;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  margin: 0 0 12rpx;
  padding: 0 0 3rpx;
  box-sizing: border-box;
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.send-button--pressed {
  opacity: 0.85;
}

.send-button--disabled {
  color: #ffffff;
  background: #c4d4e6;
}
