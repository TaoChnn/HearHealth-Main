page {
  height: 100%;
  overflow: hidden;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f7f7f8;
  color: var(--color-ink);
}

/* 助手标记：保留 BT·01，缩小为消息旁的识别图标 */
.message-ai-mark {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  margin: 0 14rpx 4rpx 0;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 20rpx 32rpx 48rpx;
}

/* 运行模式提示：游客（没有云端档案）与离线（未配置大模型）都如实告知 */
.mode-banner {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  color: #745d28;
  background: #faf6ea;
  border-bottom: 2rpx solid #eee7d5;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ===== 空状态：以 BT·01 为主角，配合克制的排版与留白 ===== */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 116rpx;
}

.welcome-bot {
  width: 148rpx;
  height: 145rpx;
  animation: welcome-bot-bob 3.4s ease-in-out infinite;
}

@keyframes welcome-bot-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.welcome-title {
  margin-top: 30rpx;
  color: #19191b;
  font-size: 46rpx;
  font-weight: 650;
  letter-spacing: -1.5rpx;
  line-height: 1.22;
}

.welcome-text {
  margin-top: 18rpx;
  color: #737378;
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
}

.suggestion-block {
  width: 100%;
  margin-top: 66rpx;
}

.suggestion-label {
  color: #8b8b90;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  text-align: left;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
}

.suggestion-chip {
  box-sizing: border-box;
  padding: 17rpx 22rpx;
  color: #3d3d42;
  background: #ffffff;
  border: 2rpx solid #e9e9eb;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.35;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.02);
}

.message-row {
  display: flex;
  align-items: flex-end;
  margin-top: 34rpx;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

/* 助手侧的气泡、溯源标签与动作卡片共用一个纵向容器，宽度由容器统一收敛 */
.message-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 82%;
}

.message-row--user .message-stack {
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 20rpx 23rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  line-height: 1.62;
  word-break: break-word;
  white-space: pre-wrap;
}

.message-bubble--user {
  color: #ffffff;
  background: #19191b;
  border-bottom-right-radius: 5rpx;
}

.message-bubble--assistant {
  color: #262629;
  background: #ffffff;
  border: 2rpx solid #ededee;
  border-bottom-left-radius: 5rpx;
  box-shadow: none;
  line-height: 1.65;
}

/* 溯源标签：回答用到了哪些档案数据，点击可跳到档案核对 */
.source-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
}

.source-label {
  color: #8b8b90;
  font-size: 20rpx;
}

.source-chip {
  padding: 6rpx 16rpx;
  color: #2463cf;
  background: #f7faff;
  border: 2rpx solid #e2ecff;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
}

/* Agent 提议/完成的档案写入：确认前不落库，落库后保留撤销入口 */
.action-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-md);
}

.action-card--pending {
  border-color: #dceafb;
  background: #f8fbff;
}

.action-card--confirming,
.action-card--applied {
  border-color: #d7ecd9;
  background: #f6fcf7;
}

.action-card--cancelled,
.action-card--dismissed,
.action-card--undo-failed {
  border-color: var(--color-divider-soft);
  background: var(--color-surface-pearl);
}

.action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.action-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.action-state {
  flex-shrink: 0;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.action-summary {
  margin-top: 10rpx;
  color: var(--color-ink-muted-80);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 60rpx;
}

.action-btn::after {
  border: none;
}

.action-btn--primary {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.action-btn--ghost {
  color: var(--color-ink-muted-48);
  background: var(--color-canvas);
  border: 2rpx solid var(--color-hairline);
}

/* 逐字渲染时挂在回复末尾的光标 */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  margin-left: 4rpx;
  vertical-align: -5rpx;
  background: #19191b;
  animation: cursor-blink 0.9s steps(1) infinite;
}

@keyframes cursor-blink {
  50% { opacity: 0; }
}

.loading-bubble {
  display: flex;
  align-items: center;
  color: var(--color-ink-muted-48);
}

.loading-dots {
  display: flex;
  gap: 6rpx;
  margin-left: 12rpx;
}

.loading-dots view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-ink-muted-48);
  animation: chat-dot 1.2s infinite ease-in-out;
}

.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes chat-dot {
  0%, 60%, 100% { opacity: 0.28; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-4rpx); }
}

.chat-error {
  margin: 24rpx 0 0 66rpx;
  padding: 20rpx 22rpx;
  background: #fff5f4;
  border-radius: var(--radius-md);
}

.chat-error-text {
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.45;
}

.retry-button {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  color: var(--color-primary);
  background: var(--color-canvas);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 56rpx;
}

.retry-button::after,
.send-button::after {
  border: none;
}

.chat-bottom {
  height: 2rpx;
}

.chat-footer {
  flex-shrink: 0;
  padding: 18rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(247, 247, 248, 0.96);
  border-top: 2rpx solid #e9e9eb;
}

/* 免责声明收成一行脚注，放在输入框下方，不再挤压版面 */
.chat-disclaimer {
  margin-top: 13rpx;
  color: #939398;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

/* ===== 输入框上方的快捷卡片与历史抽屉 ===== */
.quick-actions {
  display: flex;
  align-items: center;
  height: 86rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #e5e5e7;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.035);
}

.quick-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 100%;
  gap: 12rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  color: #35353a;
}

.quick-card + .quick-card::before {
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 0;
  width: 2rpx;
  background: #ececee;
  content: '';
}

.quick-card--pressed {
  background: #f3f3f4;
}

.quick-card-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.78;
}

.quick-card-archive-icon {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5rpx;
  box-sizing: border-box;
  width: 29rpx;
  height: 32rpx;
  padding-left: 7rpx;
  border: 2rpx solid #3b3b40;
  border-radius: 4rpx;
}

.quick-card-archive-icon::before {
  position: absolute;
  top: -2rpx;
  left: 5rpx;
  width: 15rpx;
  height: 5rpx;
  background: #ffffff;
  border: 2rpx solid #3b3b40;
  border-radius: 3rpx;
  content: '';
}

.quick-card-archive-icon view {
  width: 13rpx;
  height: 2rpx;
  background: #3b3b40;
  border-radius: 2rpx;
}

.quick-card-title {
  color: #2f2f33;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(20, 20, 40, 0.4);
}

.history-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  background: var(--color-canvas);
  border-radius: 26rpx 26rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: history-rise 0.25s ease-out;
}

@keyframes history-rise {
  from { transform: translateY(30%); opacity: 0.5; }
  to { transform: translateY(0); opacity: 1; }
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 18rpx;
}

.history-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.history-close {
  padding: 6rpx 10rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.history-close--pressed {
  opacity: 0.6;
}

.history-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.history-empty {
  padding: 60rpx 0;
  color: var(--color-ink-muted-48);
  font-size: 26rpx;
  text-align: center;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  padding: 24rpx 22rpx;
  background: var(--color-canvas-parchment);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-md);
}

.history-item--pressed {
  background: var(--color-surface-pearl);
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-item-title {
  color: var(--color-ink);
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item-meta {
  margin-top: 6rpx;
  color: var(--color-ink-muted-48);
  font-size: 21rpx;
}

.history-item-del {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  color: #b42318;
  background: #fff5f4;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-height: 86rpx;
  max-height: 190rpx;
  padding: 21rpx 24rpx;
  color: #202023;
  background: #ffffff;
  border: 2rpx solid #dcdcdf;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.45;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.02);
}

.composer-placeholder {
  color: #98989d;
}

/* 用 view 而非原生 button，避免小程序默认按钮样式把圆钮撑成椭圆 */
.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-end;
  width: 62rpx;
  min-width: 62rpx;
  max-width: 62rpx;
  height: 62rpx;
  margin: 0 2rpx 12rpx 0;
  padding: 0 0 3rpx;
  box-sizing: border-box;
  color: var(--color-on-primary);
  background: #19191b;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.send-button--pressed {
  opacity: 0.85;
}

.send-button--disabled {
  color: #ffffff;
  background: #c9c9cd;
}
