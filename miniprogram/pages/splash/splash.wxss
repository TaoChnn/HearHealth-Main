/* 开屏页 —— 极简白底 · 高级感（涟漪保留，去蓝渐变 / 光晕 / 多余提示） */

.splash-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 220rpx var(--spacing-lg) calc(env(safe-area-inset-bottom) + 120rpx);
  overflow: hidden;
  background: #ffffff;
}

/* 背景层：纯白保留为独立节点，方便后续切换深色模式或加纹理 */
.splash-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
}

/* ===== 声波涟漪层 =====
   涟漪容器是 logo-wrap（340rpx）的定位锚点：
   通过负 margin 让 520rpx 圆环的圆心与 logo 圆心重合 */
.splash-ripple {
  position: absolute;
  top: 170rpx;            /* logo-wrap 高度一半 */
  left: 50%;
  width: 520rpx;
  height: 520rpx;
  margin-left: -260rpx;   /* 水平居中 */
  margin-top: -260rpx;    /* 垂直对齐圆心 */
  pointer-events: none;
  z-index: 0;
}

.ripple-circle {
  position: absolute;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  border: 1rpx solid #e5e5e7;
  opacity: 0;
  animation: ripple-out 4.8s cubic-bezier(0.1, 0.6, 0.4, 1) infinite;
}

.ripple-1 { animation-delay: 0s; }
.ripple-2 { animation-delay: 0.95s; }
.ripple-3 { animation-delay: 1.9s; }
.ripple-4 { animation-delay: 2.85s; }
.ripple-5 { animation-delay: 3.8s; }

@keyframes ripple-out {
  0% {
    transform: scale(0.35);
    opacity: 0.7;
  }
  80% {
    opacity: 0.12;
  }
  100% {
    transform: scale(1.25);
    opacity: 0;
  }
}

/* ===== 品牌区 ===== */
.splash-brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  animation: fade-up 0.7s ease-out both;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 极简浅色描边圆，去掉玻璃 / 发光 / 阴影 */
.splash-logo-wrap {
  position: relative;
  z-index: 1;
  width: 340rpx;
  height: 340rpx;
  margin-bottom: 52rpx;
}

.splash-logo {
  width: 100%;
  height: 100%;
  /* 折纸 logo 为不规则多边形，不加圆角避免裁掉尖角 */
}

.splash-name {
  color: #1d1d1f;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.1;
}

/* ===== 操作区 ===== */
.splash-actions {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  animation: fade-up 0.7s ease-out 0.35s both;
}

/* 黑底白字主按钮：Apple 风格圆角，去掉发光 */
.splash-login-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #1d1d1f;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
  border: none;
}

.splash-login-btn::after { border: none; }

.splash-login-btn--pressed {
  background: #2c2c2e;
  transform: scale(0.99);
}

.splash-login-btn--loading {
  opacity: 0.65;
}

/* 协议勾选：单行 nowrap，避免《用户协议》/《隐私政策》在窄屏被错误换行 */
.splash-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: var(--spacing-xxs) var(--spacing-xs);
  max-width: 100%;
  box-sizing: border-box;
}

.splash-checkbox {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border: 1.5rpx solid #c7c7cc;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
}

.splash-checkbox--checked {
  border-color: #1d1d1f;
  background: #1d1d1f;
}

.splash-checkbox--checked::after {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 2rpx solid #ffffff;
  border-bottom: 2rpx solid #ffffff;
  transform: rotate(40deg);
  content: "";
}

.splash-agreement-text {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  color: #86868b;
  font-size: 24rpx;
  line-height: 1.4;
}

.splash-agreement-text__and {
  margin: 0 6rpx;
  color: #86868b;
}

.splash-link {
  color: #1d1d1f;
  text-decoration: underline;
  text-underline-offset: 3rpx;
}

.splash-error {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xxs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: #fff4f4;
  color: #c5302a;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
  border: 1rpx solid #fde0e0;
}

/* 已登录用户的进入提示 */
.splash-entering {
  color: #86868b;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}