<view class="splash-page">
  <!-- 极简白底，不再叠蓝渐变与光晕 -->
  <view class="splash-bg"></view>

  <!-- 品牌区：声波涟漪 + 耳机图标 + 名称 -->
  <view class="splash-brand">
    <!-- 声波涟漪层：以耳机图标为中心扩散 -->
    <view class="splash-ripple" aria-hidden="true">
      <view class="ripple-circle ripple-1"></view>
      <view class="ripple-circle ripple-2"></view>
      <view class="ripple-circle ripple-3"></view>
      <view class="ripple-circle ripple-4"></view>
      <view class="ripple-circle ripple-5"></view>
    </view>
    <view class="splash-logo-wrap">
      <image class="splash-logo" src="/images/icons/splash-logo.png" mode="aspectFill"></image>
    </view>
    <view class="splash-name">HearHealth</view>
  </view>

  <!-- 操作区 -->
  <view class="splash-actions">
    <!-- 未登录才展示登录入口；已登录用户只看到进入提示，避免误以为还需要登录 -->
    <block wx:if="{{!loggedIn}}">
      <button
        class="splash-login-btn {{loggingIn ? 'splash-login-btn--loading' : ''}}"
        bindtap="onLoginTap"
        hover-class="splash-login-btn--pressed"
        disabled="{{loggingIn}}"
      >
        <text>{{loggingIn ? '正在登录…' : '微信一键登录'}}</text>
      </button>

      <!-- 协议勾选：单行 nowrap，避免《用户协议》/《隐私政策》在窄屏被错误换行 -->
      <view class="splash-agreement" bindtap="onToggleAgree">
        <view class="splash-checkbox {{agreed ? 'splash-checkbox--checked' : ''}}"></view>
        <view class="splash-agreement-text">
          <text>已阅读并同意</text>
          <text class="splash-link" data-type="terms" catchtap="onAgreementTap">《用户协议》</text>
          <text class="splash-agreement-text__and">和</text>
          <text class="splash-link" data-type="privacy" catchtap="onAgreementTap">《隐私政策》</text>
        </view>
      </view>

      <view class="splash-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    </block>

    <view class="splash-entering" wx:else>已登录，正在进入…</view>
  </view>
</view>