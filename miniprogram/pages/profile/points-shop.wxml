<view class="points-shop-page">
  <view class="shop-hero">
    <view class="hero-orb hero-orb--one"></view>
    <view class="hero-orb hero-orb--two"></view>
    <view class="hero-topline">
      <view>
        <view class="hero-eyebrow">HEAR REWARDS</view>
        <view class="hero-title">积分好礼</view>
      </view>
      <view class="hero-record" data-view="orders" bindtap="onViewTap">
        <text>兑换记录</text>
        <text class="hero-record-arrow">›</text>
      </view>
    </view>
    <view class="balance-row">
      <view class="balance-copy">
        <view class="balance-label">可用积分</view>
        <view class="balance-value">{{pointsLoading ? '—' : pointsBalance}}</view>
      </view>
      <view class="balance-mark">
        <view class="balance-mark-inner">H</view>
      </view>
    </view>
  </view>

  <view class="login-banner" wx:if="{{needLogin}}">
    <view class="login-copy">
      <view class="login-title">登录后兑换好礼</view>
      <view class="login-description">同步积分余额与兑换记录</view>
    </view>
    <view class="login-button" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="error-banner" wx:if="{{pointsError}}">
    <text>{{pointsError}}</text>
    <text class="error-retry" bindtap="retryPoints">重新加载</text>
  </view>

  <view class="view-tabs">
    <view class="view-tab {{activeView === 'products' ? 'view-tab--active' : ''}}" data-view="products" bindtap="onViewTap">精选好物</view>
    <view class="view-tab {{activeView === 'orders' ? 'view-tab--active' : ''}}" data-view="orders" bindtap="onViewTap">兑换记录</view>
    <view class="view-tab {{activeView === 'points' ? 'view-tab--active' : ''}}" data-view="points" bindtap="onViewTap">积分明细</view>
  </view>

  <block wx:if="{{activeView === 'products'}}">
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-row">
        <view
          class="category-chip {{activeCategory === item.id ? 'category-chip--active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-category="{{item.id}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="section-heading">
      <view class="section-title">为你精选</view>
      <view class="section-meta">每人每款限兑 1 件</view>
    </view>

    <view class="product-grid">
      <view
        class="product-card"
        wx:for="{{visibleProducts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onProductTap"
        hover-class="product-card--pressed"
      >
        <view class="product-media">
          <image class="product-image" src="{{item.image}}" mode="aspectFit"></image>
          <view class="product-tag">{{item.categoryLabel}}</view>
          <view class="product-status" wx:if="{{item.redeemed}}">已兑换</view>
          <view class="product-status product-status--sold" wx:elif="{{item.soldOut}}">已兑完</view>
        </view>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-description">{{item.description}}</view>
          <view class="product-footer">
            <view class="product-price"><text>{{item.points}}</text><text class="product-price-unit">积分</text></view>
            <view class="product-go">›</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeView === 'orders'}}">
    <view class="list-heading">
      <view class="section-title">我的兑换</view>
      <view class="section-meta">{{orders.length}} 笔记录</view>
    </view>
    <view class="record-list" wx:if="{{orders.length}}">
      <view class="order-row" wx:for="{{orders}}" wx:key="id">
        <image class="order-image" src="{{item.productImage}}" mode="aspectFill"></image>
        <view class="order-copy">
          <view class="order-name">{{item.productName}}</view>
          <view class="order-meta">{{item.timeText}} · {{item.points}} 积分</view>
        </view>
        <view class="order-status order-status--{{item.status}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">◇</view>
      <view class="empty-title">还没有兑换记录</view>
      <view class="empty-action" data-view="products" bindtap="onViewTap">去逛逛</view>
    </view>
  </block>

  <block wx:else>
    <view class="list-heading">
      <view class="section-title">积分明细</view>
      <view class="section-meta">最近 {{pointsEntries.length}} 笔</view>
    </view>
    <view class="record-list" wx:if="{{pointsEntries.length}}">
      <view class="ledger-row" wx:for="{{pointsEntries}}" wx:key="id">
        <view class="ledger-symbol ledger-symbol--{{item.direction}}">{{item.direction === 'credit' ? '+' : '−'}}</view>
        <view class="ledger-copy">
          <view class="ledger-title">{{item.title}}</view>
          <view class="ledger-time">{{item.timeText}}</view>
        </view>
        <view class="ledger-points ledger-points--{{item.direction}}">{{item.pointsText}}</view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">◎</view>
      <view class="empty-title">暂无积分记录</view>
    </view>
  </block>

  <view class="shop-note">奖品数量有限，兑换成功后由工作人员核验并安排发放。</view>

  <view class="sheet-mask" wx:if="{{showProductSheet}}" bindtap="onCloseProduct">
    <view class="product-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <image class="sheet-image" src="{{selectedProduct.image}}" mode="aspectFit"></image>
      <view class="sheet-content">
        <view class="sheet-category">{{selectedProduct.categoryLabel}}</view>
        <view class="sheet-name">{{selectedProduct.name}}</view>
        <view class="sheet-description">{{selectedProduct.description}}</view>
        <view class="sheet-facts">
          <view class="sheet-fact">
            <view class="sheet-fact-value">{{selectedProduct.points}}</view>
            <view class="sheet-fact-label">所需积分</view>
          </view>
          <view class="sheet-divider"></view>
          <view class="sheet-fact">
            <view class="sheet-fact-value">{{selectedProduct.remainingStock}}</view>
            <view class="sheet-fact-label">剩余数量</view>
          </view>
          <view class="sheet-divider"></view>
          <view class="sheet-fact">
            <view class="sheet-fact-value">1</view>
            <view class="sheet-fact-label">每人限兑</view>
          </view>
        </view>
        <view
          class="redeem-button {{selectedProduct.canRedeem ? '' : 'redeem-button--disabled'}}"
          data-id="{{selectedProduct.id}}"
          bindtap="onRedeemSelected"
        >{{redeeming ? '兑换中…' : selectedProduct.actionText}}</view>
        <view class="sheet-note">兑换时需授权微信收货地址</view>
      </view>
    </view>
  </view>
</view>
