/* 健康档案主页 —— 简约列表风格：常规字重、灰值右对齐、少颜色少解释 */
.archive-page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 0 0 calc(80rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.archive-loading {
  padding: var(--spacing-xl) 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  text-align: center;
}

.page-header {
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-sm);
}

.page-title {
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

/* 待补充提示：一行淡灰小字，代替原完整度卡片 */
.archive-missing {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

/* 游客提示条 */
.guest-banner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: calc(100% - var(--spacing-md) * 2);
  margin: 0 var(--spacing-md) var(--spacing-sm);
  padding: var(--spacing-sm);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.guest-copy {
  flex: 1;
  min-width: 0;
}

.guest-title {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 600;
}

.guest-desc {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.guest-login {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: 12rpx 28rpx;
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: var(--text-caption);
}

.guest-login--pressed {
  background: var(--color-primary-focus);
}

/* 分组标题：常规字重，只做轻分隔 */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  font-weight: 400;
}

.section-more {
  color: var(--color-primary);
  font-size: var(--text-caption);
}

/* 分组列表 */
.group-list {
  margin: 0 var(--spacing-md);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-canvas);
}

.group-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.group-row:last-child {
  border-bottom: none;
}

.group-row--hover {
  background: var(--color-surface-pearl);
}

.row-main {
  flex: 1;
  min-width: 0;
}

/* 行标题常规字重，靠分组和留白建立层级 */
.row-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 400;
  line-height: 1.4;
}

.row-value {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-body-strong);
  text-align: right;
}

/* 摘要允许最多 2 行，避免信息被截断得看不懂 */
.row-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
  word-break: break-word;
}

/* 日志与记忆正文可能较长，最多 3 行后再截断 */
.note-content {
  -webkit-line-clamp: 3;
}

.row-meta {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

/* 删除：纯文字，不再用药丸底色 */
.row-delete {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: var(--spacing-xxs) 0 var(--spacing-xxs) var(--spacing-sm);
  color: var(--color-danger);
  font-size: var(--text-caption);
}

.group-row--danger .row-title--danger {
  color: var(--color-danger);
}

.empty-row {
  display: block;
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

/* 日志录入：标签直接铺开点选，输入，右下保存 */
.note-composer {
  box-sizing: border-box;
  margin: 0 var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
}

.note-types {
  display: flex;
  flex-wrap: wrap;
}

.note-type-chip {
  margin: 0 var(--spacing-xs) var(--spacing-xxs) 0;
  padding: 10rpx 26rpx;
  color: var(--color-ink-muted-48);
  background: var(--color-canvas-parchment);
  border-radius: var(--radius-pill);
  font-size: var(--text-caption);
  line-height: 1.4;
}

.note-type-chip--active {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  max-height: 240rpx;
  margin-top: var(--spacing-xxs);
  padding: 0;
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.5;
}

.note-placeholder {
  color: #a1a1a6;
  font-size: var(--text-body);
}

.note-actions {
  display: flex;
  justify-content: flex-end;
}

.note-save {
  padding: var(--spacing-xxs) 0;
  color: var(--color-primary);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: var(--leading-caption);
}

.note-save--disabled {
  color: #b0b0b5;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  max-height: 240rpx;
  padding: 0;
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.5;
}

.note-placeholder {
  color: #a1a1a6;
  font-size: var(--text-body);
}
