/* 首页样式 */
.home-page {
  padding-bottom: 0;
  background: var(--color-canvas-parchment);
}

/* ========== 顶部卡片 ========== */
.top-card {
  position: relative;
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  margin: 32rpx 34rpx 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 卡片正面：问候语 + 进度环，点击后模糊淡出 */
.card-front {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: filter 0.35s ease, opacity 0.35s ease;
}

.show-tip .card-front {
  filter: blur(6px);
  -webkit-filter: blur(6px);
  opacity: 0;
  pointer-events: none;
}

/* 卡片背面：护耳小知识，待正面淡出后再淡入 */
.tip-face {
  position: absolute;
  top: 50%;
  left: 40rpx;
  right: 40rpx;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.show-tip .tip-face {
  opacity: 1;
  transition-delay: 0.25s;
}

.top-left {
  flex: 1;
  padding-right: 20rpx;
}

.greeting {
  font-size: var(--text-lead);
  font-weight: 700;
  color: var(--color-ink);
  line-height: var(--leading-display);
}

.subtitle {
  font-size: var(--text-caption);
  color: var(--color-ink-muted-48);
  margin-top: 12rpx;
}

/* 护耳小知识（背面层）：标题 + 三条要点 */
.tip-title {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: var(--text-caption);
  line-height: var(--leading-body);
  color: var(--color-ink);
}

.tip-item:first-of-type {
  margin-top: 0;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-num {
  color: var(--color-primary);
  font-weight: 700;
}

.top-right {
  flex-shrink: 0;
}

/* 进度环 —— 使用 conic-gradient 替代 canvas，避免 DPR 模糊与端点抖动 */
.progress-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.progress-track {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 20rpx;
}

.progress-hole {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-canvas);
}

/* 进度条两端圆角小圆点（直径=环粗，像 Apple Watch 圆环端点） */
.progress-cap {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.progress-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
}

.progress-label {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-bottom: 4rpx;
}

.progress-value {
  font-size: var(--text-body);
  font-weight: 700;
  color: var(--color-ink);
}

/* ========== 快捷入口 ========== */
.quick-entries {
  display: flex;
  gap: 24rpx;
  padding: 0 34rpx 28rpx;
}

.entry-card {
  flex: 1;
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-divider-soft);
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.entry-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.entry-title {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
}

/* ========== AI 助手入口（玻璃卡片 + 边框流动色带） ========== */
.ai-entry-wrap {
  position: relative;
  margin: 0 34rpx 28rpx;
}

/* 玻璃体的边框色带：颜色只留在棱边，向内微渗；渐变颜色由 JS 按
   今日用耳风险档位下发（normal 蓝 / warning 黄 / danger 紫红） */
.ai-entry-card {
  position: relative;
  /* 底层色带：颜色更淡，作为被玻璃折射的"衬色层"而非描边 */
  padding: 5rpx;
  /* 圆润程度介于普通卡片与胶囊之间 */
  border-radius: 72rpx;
  background-size: 260% 260%;
  overflow: hidden;
  transition: transform 0.15s ease;
  animation: ai-entry-card-flow 8s ease-in-out infinite alternate;
}

/* 渐变沿边缘流动，投影压得很低，不干扰相邻卡片 */
@keyframes ai-entry-card-flow {
  0% {
    background-position: 0% 50%;
    box-shadow: 0 4rpx 12rpx rgba(124, 92, 255, 0.06);
  }
  100% {
    background-position: 100% 50%;
    box-shadow: 0 4rpx 12rpx rgba(124, 92, 255, 0.12);
  }
}

.ai-entry-card--pressed {
  transform: scale(0.98);
}

/* 内层：干净的白色玻璃体，色彩只从棱边微渗进来 */
.ai-entry-card-inner {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 67rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(250, 251, 255, 0.52) 48%, rgba(255, 255, 255, 0.62));
  backdrop-filter: blur(18rpx) saturate(1.15);
  -webkit-backdrop-filter: blur(18rpx) saturate(1.15);
  padding: 24rpx 28rpx;
  box-shadow: inset 0 0 6rpx var(--ai-glow, rgba(140, 180, 255, 0.14));
}

/* bot 圆珠：外圈呼吸光晕 + 随健康档位变色的渐变球体 */
.ai-entry-badge-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.ai-entry-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 124rpx;
  height: 124rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  /* 光晕颜色 = 健康色，随风险档位变化 */
  background: radial-gradient(circle, var(--ai-halo, rgba(140, 180, 255, 0.4)), transparent 72%);
  animation: ai-entry-glow 2.8s ease-in-out infinite;
}

@keyframes ai-entry-glow {
  0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.9); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
}

.ai-entry-badge {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 球体渐变 = 健康色，由 JS 按风险档位注入（--ai-band），与边框色带同色系 */
  background-image:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 45%),
    var(--ai-band, linear-gradient(135deg, #6ea8ff, #7c5cff 45%, #38bdf8));
  background-size: auto, 220% 220%;
  border: 3rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.45),
    inset 0 -8rpx 14rpx rgba(40, 40, 80, 0.3),
    0 8rpx 18rpx rgba(40, 28, 100, 0.35);
  animation: ai-entry-flow 6s ease-in-out infinite alternate;
}

@keyframes ai-entry-flow {
  0% { background-position: 0% 0%, 0% 50%; }
  100% { background-position: 0% 0%, 100% 50%; }
}

/* bot 眼睛：两颗斜向高光胶囊（参考 bot 头像），偶尔眨一下 */
.ai-entry-eyes {
  display: flex;
  align-items: center;
  gap: 10rpx;
  transform: rotate(26deg) translate(2rpx, -6rpx);
}

.ai-entry-eye {
  width: 10rpx;
  height: 22rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(235, 240, 255, 0.82));
  animation: ai-entry-blink 4.2s ease-in-out infinite;
}

@keyframes ai-entry-blink {
  0%, 90%, 100% { transform: scaleY(1); }
  94%, 96% { transform: scaleY(0.1); }
}

.ai-entry-content {
  flex: 1;
  min-width: 0;
  margin: 0 8rpx 0 20rpx;
}

.ai-entry-title {
  font-size: var(--text-body-strong);
  font-weight: 700;
  color: var(--color-ink);
}

.ai-entry-tip {
  margin-top: 6rpx;
  font-size: var(--text-caption);
  color: var(--color-ink-muted-80);
  line-height: var(--leading-caption);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ai-entry-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #7c5cff;
}

/* ========== 通用卡片 ========== */
.card {
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  margin: 0 34rpx 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: var(--text-body-strong);
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-header .card-title {
  margin-bottom: 0;
}

.card-more {
  font-size: var(--text-caption);
  color: var(--color-primary);
}

/* ========== 本周柱状图 ========== */
.bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding-top: 16rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-col {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-height: 0;
}

.bar-tip {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  color: var(--color-ink);
  font-size: var(--text-micro-legal);
  font-weight: 500;
  line-height: 1;
  padding: 4rpx 0;
  white-space: nowrap;
  z-index: 2;
}

.bar {
  width: 40rpx;
  height: 100%;
  border-radius: 10rpx 10rpx 0 0;
}

.bar-normal {
  background: linear-gradient(180deg, #5cd97a, var(--color-success));
}

.bar-warning {
  background: linear-gradient(180deg, #ffdd4d, var(--color-warning));
}

.bar-danger {
  background: linear-gradient(180deg, #ff6b6b, var(--color-danger));
}

.bar-label {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-top: 14rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.bar-label-today {
  color: var(--color-primary);
  font-weight: 600;
}

/* ========== 附近医院 ========== */
.hospital-list {
  margin-top: -8rpx;
}

.hospital-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.hospital-item:last-child {
  border-bottom: none;
}

.hospital-info {
  flex: 1;
  min-width: 0;
}

.hospital-name {
  font-size: var(--text-body);
  font-weight: 500;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-meta {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-top: 6rpx;
}

.hospital-arrow {
  font-size: 36rpx;
  color: var(--color-ink-muted-48);
  margin-left: 16rpx;
}
