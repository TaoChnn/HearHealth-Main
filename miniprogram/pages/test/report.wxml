<view class="container report-page">
  <block wx:if="{{hasResult}}">
    <view class="hero-card">
      <view class="hero-head">
        <view class="hero-title">听力报告</view>
        <view class="hero-time">{{completedAtText}}</view>
      </view>

      <view class="hero-ears">
        <view class="hero-ear" wx:for="{{earSummaries}}" wx:key="key">
          <view class="hero-ear-head">
            <text class="hero-ear-name">{{item.name}}</text>
            <text class="hero-ear-tag hero-ear-tag--{{item.levelKey}}">{{item.levelLabel}}</text>
          </view>
          <view class="hero-ear-value">{{item.averageText}}</view>
          <view class="hero-ear-meter">
            <view class="hero-ear-fill hero-ear-fill--{{item.levelKey}}" style="width: {{item.meterPercent}}%;"></view>
          </view>
          <view class="hero-ear-foot">平均相对阈值 · 测得 {{item.detectedText}}</view>
        </view>
      </view>

      <view class="hero-hint">百分比越小，表示耳朵状况良好</view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">频率表现</text>
        <view class="chart-legend">
          <view class="legend-item">
            <view class="legend-dot legend-dot--left"></view>
            <text>左耳</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot legend-dot--right"></view>
            <text>右耳</text>
          </view>
        </view>
      </view>

      <view class="chart-wrap">
        <canvas class="threshold-chart" id="thresholdChart" type="2d"></canvas>
        <view class="chart-fallback" wx:if="{{chartDrawFailed}}">当前设备无法绘制图表。</view>
      </view>
    </view>

    <view class="ai-card">
      <view class="ai-head">
        <view class="ai-badge">AI</view>
        <text class="ai-title">结果解读</text>
        <view
          class="ai-more"
          wx:if="{{aiStatus === 'success' && aiAnalysis.hasDetail}}"
          bindtap="toggleAiDetail"
        >{{aiExpanded ? '收起' : '详情'}}</view>
      </view>

      <view class="ai-loading" wx:if="{{aiStatus === 'loading'}}">
        <view class="ai-spinner" aria-hidden="true"></view>
        <text class="ai-loading-text">正在生成解读…</text>
      </view>

      <block wx:elif="{{aiStatus === 'success' && aiAnalysis}}">
        <view class="ai-overview">{{aiAnalysis.overview}}</view>

        <view class="ai-tips" wx:if="{{aiAnalysis.recommendations.length}}">
          <view class="ai-tip" wx:for="{{aiAnalysis.recommendations}}" wx:for-item="tip" wx:key="id">
            <view class="ai-tip-dot"></view>
            <text class="ai-tip-text">{{tip.text}}</text>
          </view>
        </view>

        <view class="ai-flags" wx:if="{{aiAnalysis.redFlags.length}}">
          <text class="ai-flags-title">留意</text>
          <view class="ai-flag" wx:for="{{aiAnalysis.redFlags}}" wx:for-item="flag" wx:key="*this">{{flag}}</view>
        </view>

        <view class="ai-detail" wx:if="{{aiExpanded}}">
          <view class="ai-detail-block" wx:for="{{aiAnalysis.findings}}" wx:for-item="finding" wx:key="id">
            <view class="ai-detail-title">{{finding.title}}</view>
            <view class="ai-detail-text">{{finding.explanation}}</view>
          </view>
          <view class="ai-detail-block" wx:if="{{aiAnalysis.earComparison.summary}}">
            <view class="ai-detail-title">左右耳对比</view>
            <view class="ai-detail-text">{{aiAnalysis.earComparison.summary}}</view>
          </view>
          <view class="ai-detail-block" wx:if="{{aiAnalysis.limitations.length}}">
            <view class="ai-detail-title">测试局限</view>
            <view class="ai-detail-text" wx:for="{{aiAnalysis.limitations}}" wx:for-item="limit" wx:key="*this">{{limit}}</view>
          </view>
        </view>
      </block>

      <view class="ai-error" wx:elif="{{aiStatus === 'error'}}">
        <text class="ai-error-text">{{aiErrorMessage}}</text>
        <text class="ai-error-retry" wx:if="{{aiCanRetry}}" bindtap="retryAiAnalysis">重新生成</text>
      </view>
    </view>

    <view class="report-note">结果与 AI 解读仅供参考，不构成医学诊断。</view>
  </block>

  <view class="empty-state" wx:else>
    <view class="empty-icon" aria-hidden="true">🎧</view>
    <view class="empty-title">暂无完整测试结果</view>
  </view>

  <view class="report-actions">
    <button
      class="report-button report-button--primary {{(navigating || shareLoading) ? 'report-button--disabled' : ''}}"
      hover-class="report-button--primary-pressed"
      disabled="{{navigating || shareLoading}}"
      wx:if="{{hasResult}}"
      bindtap="shareToCommunity"
    >{{shareLoading ? '生成长图…' : '分享到耳友圈'}}</button>
    <button
      class="report-button report-button--primary {{navigating ? 'report-button--disabled' : ''}}"
      hover-class="report-button--primary-pressed"
      disabled="{{navigating}}"
      wx:else
      bindtap="startTest"
    >开始测试</button>

    <view class="report-actions-row">
      <button
        class="report-button report-button--ghost {{navigating ? 'report-button--disabled' : ''}}"
        hover-class="report-button--ghost-pressed"
        disabled="{{navigating}}"
        wx:if="{{hasResult}}"
        bindtap="startTest"
      >重新测试</button>
      <button
        class="report-button report-button--ghost {{navigating ? 'report-button--disabled' : ''}}"
        hover-class="report-button--ghost-pressed"
        disabled="{{navigating}}"
        bindtap="returnHome"
      >返回首页</button>
    </view>
  </view>

  <!-- 离屏画布：仅用于绘制分享长图，不参与页面显示 -->
  <canvas class="share-canvas" id="shareCanvas" type="2d"></canvas>
</view>
