/* 听力报告：结论优先，AI 解读作为辅助信息 */
.report-page {
  background: var(--color-canvas-parchment);
}

/* ========== 顶部结论卡 ========== */
.hero-card {
  box-sizing: border-box;
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.hero-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero-title {
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
  letter-spacing: -1rpx;
}

.hero-time {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.hero-ears {
  display: flex;
  margin-top: var(--spacing-md);
  gap: var(--spacing-sm);
}

.hero-ear {
  flex: 1;
  min-width: 0;
  padding: var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.hero-ear-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-ear-name {
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  font-weight: 600;
}

.hero-ear-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-micro-legal);
  font-weight: 600;
}

.hero-ear-tag--good {
  background: rgba(52, 199, 89, 0.14);
  color: #248a3d;
}

.hero-ear-tag--watch {
  background: rgba(255, 204, 0, 0.2);
  color: #8a6d00;
}

.hero-ear-tag--notice {
  background: rgba(255, 59, 48, 0.1);
  color: #d70015;
}

.hero-ear-value {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-lead-airy);
  font-weight: 700;
  line-height: var(--leading-display);
}

.hero-ear-meter {
  overflow: hidden;
  height: 8rpx;
  margin-top: var(--spacing-xs);
  border-radius: var(--radius-pill);
  background: var(--color-divider-soft);
}

.hero-ear-fill {
  height: 100%;
  border-radius: var(--radius-pill);
}

.hero-ear-fill--good {
  background: var(--color-success);
}

.hero-ear-fill--watch {
  background: var(--color-warning);
}

.hero-ear-fill--notice {
  background: var(--color-danger);
}

.hero-ear-foot {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

.hero-hint {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

/* ========== 通用区块 ========== */
.section-card {
  box-sizing: border-box;
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.chart-legend {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.legend-item {
  display: flex;
  align-items: center;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.legend-dot {
  width: var(--spacing-xs);
  height: var(--spacing-xs);
  margin-right: var(--spacing-xxs);
  border-radius: var(--radius-full);
}

.legend-dot--left {
  background: var(--color-primary);
}

.legend-dot--right {
  background: var(--color-success);
}

.chart-wrap {
  position: relative;
  margin-top: var(--spacing-sm);
}

.threshold-chart {
  display: block;
  width: 100%;
  height: 440rpx;
}

.chart-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  text-align: center;
}

/* ========== AI 解读 ========== */
.ai-card {
  box-sizing: border-box;
  margin: var(--spacing-md) var(--spacing-md) 0;
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ai-head {
  display: flex;
  align-items: center;
}

.ai-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-xs);
  border-radius: var(--radius-sm);
  background: rgba(0, 102, 204, 0.09);
  color: var(--color-primary);
  font-size: var(--text-micro-legal);
  font-weight: 700;
}

.ai-title {
  flex: 1;
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.ai-more {
  color: var(--color-primary);
  font-size: var(--text-fine-print);
}

.ai-loading {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.ai-spinner {
  box-sizing: border-box;
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--spacing-xs);
  border: 4rpx solid rgba(0, 102, 204, 0.16);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-full);
  animation: ai-spin 0.9s linear infinite;
}

@keyframes ai-spin {
  to { transform: rotate(360deg); }
}

.ai-loading-text {
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
}

.ai-overview {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.ai-tips {
  margin-top: var(--spacing-sm);
}

.ai-tip {
  display: flex;
  align-items: flex-start;
  margin-top: var(--spacing-xs);
}

.ai-tip-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 16rpx;
  margin-right: var(--spacing-xs);
  border-radius: var(--radius-full);
  background: var(--color-primary);
}

.ai-tip-text {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-flags {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: rgba(255, 204, 0, 0.14);
}

.ai-flags-title {
  color: var(--color-ink);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.ai-flag {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-detail {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 2rpx solid var(--color-divider-soft);
}

.ai-detail-block + .ai-detail-block {
  margin-top: var(--spacing-sm);
}

.ai-detail-title {
  color: var(--color-ink);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.ai-detail-text {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.ai-error-text {
  flex: 1;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-error-retry {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.report-note {
  margin: var(--spacing-sm) var(--spacing-md) 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}

/* ========== 空态与操作 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: var(--spacing-xl) var(--spacing-md);
  padding: var(--spacing-xl) var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
  text-align: center;
}

.empty-icon {
  font-size: var(--text-display-lg);
}

.empty-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.report-actions {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
}

.report-actions-row {
  display: flex;
  margin-top: var(--spacing-sm);
  gap: var(--spacing-sm);
}

.report-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-pill);
  font-size: var(--text-button-utility);
  font-weight: 600;
}

.report-button::after {
  border: none;
}

.report-button--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-button-large);
}

.report-button--primary-pressed {
  background: var(--color-primary-focus);
}

.report-button--ghost {
  border: 2rpx solid var(--color-hairline);
  background: var(--color-canvas);
  color: var(--color-ink-muted-80);
}

.report-button--ghost-pressed {
  background: var(--color-surface-pearl);
}

.report-button--disabled {
  opacity: 0.48;
}

/* 分享长图画布：移出视口，只用于 canvasToTempFilePath 导出图片 */
.share-canvas {
  position: fixed;
  top: 0;
  left: -2000rpx;
  width: 750rpx;
  height: 1600rpx;
}
