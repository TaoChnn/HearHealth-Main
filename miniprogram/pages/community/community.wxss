/* 耳友圈广场 —— 设计 token 参考 DesignTemplate/apple-variables.css
   主色 #0066cc，浅灰底白卡片信息流，1px≈2rpx */

.community-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
}

.post-scroll {
  flex: 1;
  min-height: 0;
}

/* 分区导航栏（胶囊选中态，参考 custom-tab-bar 风格） */
.tab-bar {
  padding: 24rpx 24rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

/* 分区变多后改为横向滚动（参考发帖页图片横滚样式） */
.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.tab-list {
  display: inline-flex;
  padding-bottom: 14rpx;
}

.tab-item {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 30rpx;
  margin-right: 12rpx;
  border-radius: 9999rpx;
  text-align: center;
  color: #7a7a7a;
  transition: color 0.25s ease;
}

.tab-item:last-child {
  margin-right: 0;
}

.tab-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.06);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.tab-text {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 400;
  color: inherit;
  transition: font-weight 0.25s ease, color 0.25s ease;
}

.tab-item--active {
  color: #0066cc;
}

.tab-item--active .tab-bg {
  opacity: 1;
}

.tab-item--active .tab-text {
  font-weight: 600;
  color: #0066cc;
}

/* 顶部公告条：浅蓝底 + 实心「公告」徽标，引导长按 tabBar 发帖 */
.notice-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 14rpx 20rpx;
  background: rgba(0, 102, 204, 0.06);
  border-radius: 12rpx;
}

.notice-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  color: #ffffff;
  background: #0066cc;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.notice-text {
  font-size: 26rpx;
  line-height: 1.4;
  color: #0066cc;
}

/* 关闭按钮：× 字符随主题蓝，加大点击热区 */
.notice-close {
  margin-left: auto;
  padding: 8rpx 4rpx 8rpx 20rpx;
  margin-right: -8rpx;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(0, 102, 204, 0.55);
}

/* 帖子流：浅灰底上的白色圆角小卡片，参考详情页卡片样式（18rpx 圆角 + 轻阴影） */
.post-list {
  padding: 20rpx 24rpx 40rpx;
}

.post-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999px;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.post-body {
  flex: 1;
  min-width: 0;
}

/* 头部一行：昵称 + · + 时间 + · + 设备，单行截断 */
.post-head {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.3;
  color: #7a7a7a;
  flex-wrap: wrap;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-right: 8rpx;
}

.post-head-sep {
  color: #d2d2d7;
  margin: 0 8rpx;
}

.post-time,
.post-device {
  color: #7a7a7a;
}

/* 正文：唯一主字号，短帖原样、长帖最多 6 行截断 */
.post-content {
  font-size: 30rpx;
  color: #1d1d1f;
  line-height: 1.5;
  margin-top: 10rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

/* 封面：固定尺寸方图预览，圆角裁切 + 轻阴影（内容超出按 aspectFill 居中裁切） */
.post-thumb {
  margin-top: 16rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f0f0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.post-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部互动行：图标统计 + 板块标签右对齐 */
.post-stats {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7a7a7a;
  margin-right: 28rpx;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 板块标签：去掉背景色块，作为细分隔的小字 */
.post-tag-inline {
  margin-left: auto;
  font-size: 22rpx;
  color: #0066cc;
  font-weight: 500;
}

/* 空状态 */
.empty-tip {
  margin-top: 120rpx;
  text-align: center;
  color: #7a7a7a;
  font-size: 28rpx;
}

