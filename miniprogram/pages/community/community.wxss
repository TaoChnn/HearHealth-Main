/* 耳友圈 —— 设计 token 参考 DesignTemplate/apple-variables.css
   主色 #0066cc，浅灰底白卡片信息流，1px≈2rpx
   结构：发布广场 / 排行榜 → 轮播 → 最新 + 板块 → 帖子流 */

.community-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
}

.post-scroll {
  flex: 1;
  min-height: 0;
}

/* ===== 顶部一级标签：发布广场 / 排行榜 ===== */
.main-tabs {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 10rpx 0 0;
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.05);
}

.main-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 0;
}

.main-tab + .main-tab {
  margin-left: 88rpx;
}

.main-tab-text {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 500;
  color: #8a8a8e;
  transition: color 0.25s ease;
}

.main-tab-line {
  width: 44rpx;
  height: 6rpx;
  margin-top: 8rpx;
  border-radius: 9999rpx;
  background: transparent;
  transition: background 0.25s ease;
}

.main-tab--active .main-tab-text {
  color: #0066cc;
  font-weight: 600;
}

.main-tab--active .main-tab-line {
  background: #0066cc;
}

/* ===== 轮播图（公告 / 广告位） ===== */
.banner-swiper {
  height: 260rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.banner-card--blue {
  background: linear-gradient(135deg, #0066cc 0%, #4a9bff 100%);
}

.banner-card--green {
  background: linear-gradient(135deg, #00a870 0%, #4fd1a5 100%);
}

.banner-card--purple {
  background: linear-gradient(135deg, #5b6cf9 0%, #9b8cff 100%);
}

.banner-chip {
  align-self: flex-start;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.banner-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  opacity: 0.85;
}

/* 顶部公告条：浅蓝底 + 实心「公告」徽标，引导长按 tabBar 发帖 */
.notice-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 14rpx 20rpx;
  background: rgba(0, 102, 204, 0.06);
  border-radius: 12rpx;
}

.notice-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  color: #ffffff;
  background: #0066cc;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.notice-text {
  font-size: 26rpx;
  line-height: 1.4;
  color: #0066cc;
}

/* 关闭按钮：× 字符随主题蓝，加大点击热区 */
.notice-close {
  margin-left: auto;
  padding: 8rpx 4rpx 8rpx 20rpx;
  margin-right: -8rpx;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(0, 102, 204, 0.55);
}

/* ===== 最新 / 板块筛选行 ===== */
.filter-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}

.filter-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  color: #7a7a7a;
  background: rgba(0, 0, 0, 0.05);
  transition: color 0.2s ease, background 0.2s ease;
}

/* 「最新」固定为当前排序方式，保持选中态 */
.filter-chip--fixed,
.filter-chip--picked {
  color: #0066cc;
  font-weight: 600;
  background: rgba(0, 102, 204, 0.1);
}

.filter-arrow {
  margin-left: 10rpx;
  font-size: 22rpx;
  line-height: 1;
  transition: transform 0.25s ease;
}

.filter-arrow--up {
  transform: rotate(180deg);
}

/* 板块选择面板：白色圆角卡片 + 胶囊标签流式排布 */
.section-panel {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 16rpx 4rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.section-item {
  margin: 0 16rpx 16rpx;
  padding: 12rpx 26rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: #4a4a4c;
  background: #f5f5f7;
}

.section-item--active {
  color: #0066cc;
  font-weight: 600;
  background: rgba(0, 102, 204, 0.1);
}

/* ===== 排行榜（护耳积分榜） ===== */
.rank-page {
  padding-bottom: 40rpx;
}

/* 我的积分卡：主题蓝渐变 */
.my-points {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0066cc 0%, #4a9bff 100%);
  box-shadow: 0 6rpx 20rpx rgba(0, 102, 204, 0.18);
}

.my-points-label,
.my-points-tip {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
}

.my-points-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.my-points-right {
  text-align: right;
}

.my-points-rank {
  font-size: 32rpx;
  font-weight: 600;
}

.my-points-rank--muted {
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.8;
}

.my-points-tip {
  margin-top: 8rpx;
}

.rank-header {
  padding: 32rpx 32rpx 0;
}

.rank-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.rank-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a7a7a;
}

.rank-list {
  padding: 20rpx 24rpx 0;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 当前用户所在的行：浅蓝底突出 */
.rank-item--me {
  background: rgba(0, 102, 204, 0.05);
  box-shadow: 0 2rpx 10rpx rgba(0, 102, 204, 0.12);
}

/* 名次徽标：前三名金银铜，其余灰底 */
.rank-no {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a8a8e;
  background: #f0f0f2;
}

.rank-no--1 {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb800 0%, #ffd15c 100%);
}

.rank-no--2 {
  color: #ffffff;
  background: linear-gradient(135deg, #9aa7b8 0%, #c3cddb 100%);
}

.rank-no--3 {
  color: #ffffff;
  background: linear-gradient(135deg, #cf9663 0%, #e0b58c 100%);
}

.rank-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius: 9999rpx;
  background: #f0f0f0;
}

.rank-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.rank-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #0066cc;
  background: rgba(0, 102, 204, 0.12);
}

.rank-points {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0066cc;
}

.rank-points-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.rank-loading {
  margin-top: 120rpx;
  text-align: center;
  color: #7a7a7a;
  font-size: 28rpx;
}

/* ===== 帖子流：浅灰底上的白色圆角小卡片，参考详情页卡片样式（18rpx 圆角 + 轻阴影） ===== */
.post-list {
  padding: 20rpx 24rpx 40rpx;
}

.post-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999px;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.post-body {
  flex: 1;
  min-width: 0;
}

/* 头部一行：昵称 + · + 时间 + · + 设备，单行截断 */
.post-head {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.3;
  color: #7a7a7a;
  flex-wrap: wrap;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-right: 8rpx;
}

.post-head-sep {
  color: #d2d2d7;
  margin: 0 8rpx;
}

.post-time,
.post-device {
  color: #7a7a7a;
}

/* 正文：唯一主字号，短帖原样、长帖最多 6 行截断 */
.post-content {
  font-size: 30rpx;
  color: #1d1d1f;
  line-height: 1.5;
  margin-top: 10rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

/* 封面：固定尺寸方图预览，圆角裁切 + 轻阴影（内容超出按 aspectFill 居中裁切） */
.post-thumb {
  margin-top: 16rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f0f0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.post-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部互动行：图标统计 + 板块标签右对齐 */
.post-stats {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7a7a7a;
  margin-right: 28rpx;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 板块标签：去掉背景色块，作为细分隔的小字 */
.post-tag-inline {
  margin-left: auto;
  font-size: 22rpx;
  color: #0066cc;
  font-weight: 500;
}

/* 空状态（帖子流 / 榜单共用） */
.empty-tip {
  margin-top: 120rpx;
  text-align: center;
  color: #7a7a7a;
  font-size: 28rpx;
}

.empty-retry {
  display: block;
  margin-top: 16rpx;
  color: #0066cc;
  font-size: 28rpx;
}

/* 悬浮发帖按钮 */
/* 长按「耳友圈」进入发帖的转场动画层（样式已移至 custom-tab-bar） */
